generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user
}

enum BookingMode {
  appointment
  duration
}

enum PreorderStatus {
  pending
  needs_confirmation
  accepted
  in_progress
  ready
  completed
  rejected
  cancelled
}

enum PaymentStatus {
  not_required
  pending
  paid
  refunded
}

model User {
  id Int @id @default(autoincrement())
  name String 
  login String @unique
  password String
  surname String?
  phone String?
  phoneNormalized String? @unique
  phoneVerifiedAt DateTime?
  userRole UserRole @default(user)
  email String?
  telegram String?
  role String @default("user")
  carts Cart[]
  preorders Preorder[]
}

model ServiceType {
  id Int @id @default(autoincrement())
  sortOrder Int @default(0)
  name String
  showInMain Boolean @default(false)
  phone String?
  secondPhone String?
  photo String?
  description String?
  showType String? @default("table")
  gallery String[] @default([])
  acceptsPreorders Boolean @default(false)
  allowMixedCart Boolean @default(true)
  bookingMode BookingMode @default(appointment)
  bookingCapacity Int @default(1)
  prepaymentEnabled Boolean @default(false)
  preorderItems PreorderItem[]
}

model ServiceElement {
  id Int @id @default(autoincrement())
  name String
  description String?
  price Float
  photos String[] @default([])
  type Int
  createdDate DateTime @default(now())
  isArchive Boolean @default(false)
  preorderAvailable Boolean @default(false)
  cartItems CartItem[]
  preorderItems PreorderItem[]
}

model Cart {
  id Int @id @default(autoincrement())
  userId Int @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())
  cartId Int
  serviceElementId Int
  quantity Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceElement ServiceElement @relation(fields: [serviceElementId], references: [id], onDelete: Restrict)
  @@unique([cartId, serviceElementId])
}

model Preorder {
  id Int @id @default(autoincrement())
  userId Int
  status PreorderStatus @default(pending)
  desiredStartAt DateTime
  desiredEndAt DateTime?
  scheduledStartAt DateTime
  scheduledEndAt DateTime?
  completionDueAt DateTime
  postponedUntil DateTime?
  postponementUsed Boolean @default(false)
  customerNote String?
  adminNote String?
  proposedStartAt DateTime?
  proposedEndAt DateTime?
  proposalNote String?
  paymentStatus PaymentStatus @default(not_required)
  paymentFeatureEnabled Boolean @default(false)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  items PreorderItem[]
  @@index([userId, createdAt])
  @@index([status, isArchived, scheduledStartAt])
  @@index([completionDueAt, status])
}

model PreorderItem {
  id Int @id @default(autoincrement())
  preorderId Int
  serviceElementId Int
  serviceTypeId Int
  name String
  price Float
  quantity Int
  preorder Preorder @relation(fields: [preorderId], references: [id], onDelete: Cascade)
  serviceElement ServiceElement @relation(fields: [serviceElementId], references: [id], onDelete: Restrict)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  @@index([preorderId])
}
