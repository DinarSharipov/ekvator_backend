generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  surname   String
  phone     String
  email     String?
  telegram  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

