generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user
}

model User {
  id Int @id @default(autoincrement())
  name String 
  login String @unique
  password String
  surname String?
  phone String?
  phoneNormalized String? @unique
  phoneVerifiedAt DateTime?
  userRole UserRole @default(user)
  email String?
  telegram String?
  role String @default("user")
}

model ServiceType {
  id Int @id @default(autoincrement())
  sortOrder Int @default(0)
  name String
  showInMain Boolean @default(false)
  phone String?
  secondPhone String?
  photo String?
  description String?
  showType String? @default("table")
  gallery String[] @default([])
}

model ServiceElement {
  id Int @id @default(autoincrement())
  name String
  description String?
  price Float
  photos String[] @default([])
  type Int
  createdDate DateTime @default(now())
  isArchive Boolean @default(false)
}
