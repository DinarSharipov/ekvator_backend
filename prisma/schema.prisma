generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String 
  login String
  password String
  surname String?
  phone String?
  email String?
  telegram String?
  role String
}

model ServiceType {
  id Int @id @default(autoincrement())
  name String
  showInMain Boolean @default(false)
  phone String?
  secondPhone String?
  photo String?
  description String?
  showType String? @default("table")
}

model ServiceElement {
  id Int @id @default(autoincrement())
  name String
  description String?
  price Int
  photos String[] @default([])
  type Int
  createdDate DateTime @default(now())
  isArchive Boolean @default(false)
}