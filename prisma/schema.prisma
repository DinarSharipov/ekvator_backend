generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  employee
  user
}

enum BookingMode {
  appointment
  duration
}

enum PreorderStatus {
  pending
  needs_confirmation
  accepted
  in_progress
  ready
  completed
  rejected
  cancelled
}

enum PaymentStatus {
  not_required
  pending
  paid
  refunded
}

enum CompanyMemberRole {
  owner
  employee
}

enum CompanyTopUpStatus {
  pending
  confirmed
  cancelled
}

enum CompanyLedgerKind {
  top_up
  allocation
  release
  spend
  refund
}

enum AnalyticsEventType {
  page_view
  click
}

model User {
  id Int @id @default(autoincrement())
  name String 
  login String @unique
  password String
  surname String?
  phone String?
  phoneNormalized String? @unique
  phoneVerifiedAt DateTime?
  userRole UserRole @default(user)
  email String?
  telegram String?
  role String @default("user")
  serviceAssignments UserServiceAssignment[]
  carts Cart[]
  preorders Preorder[]
  companiesCreated Company[] @relation("CompanyCreator")
  companyMemberships CompanyMember[]
  companyTopUpsCreated CompanyTopUp[] @relation("CompanyTopUpCreator")
  companyTopUpsConfirmed CompanyTopUp[] @relation("CompanyTopUpConfirmer")
  companyLedgerEntries CompanyLedgerEntry[] @relation("CompanyLedgerActor")
  analyticsEvents AnalyticsEvent[]
}

model Company {
  id Int @id @default(autoincrement())
  name String
  inn String?
  balanceMinor Int @default(0)
  createdById Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members CompanyMember[]
  topUps CompanyTopUp[]
  ledgerEntries CompanyLedgerEntry[]
  @@index([createdById])
}

model CompanyMember {
  id Int @id @default(autoincrement())
  companyId Int
  userId Int
  role CompanyMemberRole @default(employee)
  balanceMinor Int @default(0)
  qrToken String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries CompanyLedgerEntry[]
  @@unique([companyId, userId])
  @@index([userId, isActive])
}

model CompanyTopUp {
  id Int @id @default(autoincrement())
  companyId Int
  amountMinor Int
  status CompanyTopUpStatus @default(pending)
  createdById Int
  confirmedById Int?
  confirmedAt DateTime?
  note String?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User @relation("CompanyTopUpCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User? @relation("CompanyTopUpConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  @@index([companyId, status, createdAt])
}

model CompanyLedgerEntry {
  id Int @id @default(autoincrement())
  companyId Int
  companyMemberId Int?
  kind CompanyLedgerKind
  amountMinor Int
  transferId String?
  reference String?
  createdById Int?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyMember CompanyMember? @relation(fields: [companyMemberId], references: [id], onDelete: Restrict)
  createdBy User? @relation("CompanyLedgerActor", fields: [createdById], references: [id], onDelete: SetNull)
  @@index([companyId, createdAt])
  @@index([companyMemberId, createdAt])
  @@index([transferId])
}

model UserServiceAssignment {
  userId Int
  serviceTypeId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([userId, serviceTypeId])
  @@index([serviceTypeId])
}

model ServiceType {
  id Int @id @default(autoincrement())
  sortOrder Int @default(0)
  name String
  showInMain Boolean @default(false)
  phone String?
  secondPhone String?
  photo String?
  description String?
  showType String? @default("table")
  gallery String[] @default([])
  acceptsPreorders Boolean @default(false)
  allowMixedCart Boolean @default(true)
  bookingMode BookingMode @default(appointment)
  bookingCapacity Int @default(1)
  prepaymentEnabled Boolean @default(false)
  preorderItems PreorderItem[]
  userAssignments UserServiceAssignment[]
  analyticsEvents AnalyticsEvent[]
}

model AnalyticsEvent {
  id Int @id @default(autoincrement())
  eventId String @unique @db.Uuid
  visitorId String @db.Uuid
  userId Int?
  type AnalyticsEventType
  path String
  target String?
  serviceTypeId Int?
  occurredAt DateTime
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  @@index([occurredAt, visitorId])
  @@index([type, occurredAt])
  @@index([serviceTypeId, occurredAt])
}

model ServiceElement {
  id Int @id @default(autoincrement())
  name String
  description String?
  price Float
  photos String[] @default([])
  type Int
  createdDate DateTime @default(now())
  isArchive Boolean @default(false)
  preorderAvailable Boolean @default(false)
  cartItems CartItem[]
  preorderItems PreorderItem[]
}

model Cart {
  id Int @id @default(autoincrement())
  userId Int @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())
  cartId Int
  serviceElementId Int
  quantity Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  serviceElement ServiceElement @relation(fields: [serviceElementId], references: [id], onDelete: Restrict)
  @@unique([cartId, serviceElementId])
}

model Preorder {
  id Int @id @default(autoincrement())
  userId Int
  status PreorderStatus @default(pending)
  desiredStartAt DateTime
  desiredEndAt DateTime?
  scheduledStartAt DateTime
  scheduledEndAt DateTime?
  completionDueAt DateTime
  postponedUntil DateTime?
  postponementUsed Boolean @default(false)
  customerNote String?
  adminNote String?
  proposedStartAt DateTime?
  proposedEndAt DateTime?
  proposalNote String?
  paymentStatus PaymentStatus @default(not_required)
  paymentFeatureEnabled Boolean @default(false)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  items PreorderItem[]
  @@index([userId, createdAt])
  @@index([status, isArchived, scheduledStartAt])
  @@index([completionDueAt, status])
}

model PreorderItem {
  id Int @id @default(autoincrement())
  preorderId Int
  serviceElementId Int
  serviceTypeId Int
  name String
  price Float
  quantity Int
  preorder Preorder @relation(fields: [preorderId], references: [id], onDelete: Cascade)
  serviceElement ServiceElement @relation(fields: [serviceElementId], references: [id], onDelete: Restrict)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  @@index([preorderId])
}
